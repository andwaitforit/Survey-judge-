# Server
PORT=3000
LOG_LEVEL=info
# Omit to use the in-memory store (dev only; data lost on restart).
# Supabase on Vercel: use the transaction-mode pooler URL (port 6543). The direct db.<ref>.supabase.co
# host is IPv6-only, and Vercel functions cannot reach it.
DATABASE_URL=postgresql://user:pass@localhost:5432/survey_judge
# Postgres schema for the tables. On Supabase (SignalGraph project) this is survey_judge.
DATABASE_SCHEMA=
# Dev API key for the in-memory store. Random if unset (printed at boot).
DEV_API_KEY=

# Provider: stub | llm | jev
PROVIDER=stub

# Small LLM (OpenAI-compatible chat completions)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
LLM_JSON_MODE=1

# Jev: TODO(jev-api). Unverified adapter, no defaults on purpose. See docs/QUESTIONS.md.
JEV_BASE_URL=
JEV_PATH=
JEV_MODEL=
JEV_API_KEY=
